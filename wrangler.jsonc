{
  "name": "salvatucurso",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory": "dist", "binding": "ASSETS", "run_worker_first": ["/api/*", "/src/js/push-config.js"]},
  "d1_databases": [{"binding": "DB", "database_name": "salvatucurso", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "cloudflare/migrations"}],
  "triggers": {"crons": ["* * * * *"]},
  "send_email": [{"name": "EMAIL"}],
  "vars": {"APP_ORIGIN": "http://localhost:8787", "AUTH_EMAIL_ENABLED": "false"},
  "observability": {"enabled": false}
}
