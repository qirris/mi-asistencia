{
  "name": "salvatucurso",
  "account_id": "ae7e5d5863376edd16770e16298f889f",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory": "dist", "binding": "ASSETS", "run_worker_first": ["/api/*", "/src/js/push-config.js"]},
  "d1_databases": [{"binding": "DB", "database_name": "salvatucurso", "database_id": "6fb9da5f-c13f-47c2-b395-9d087c5ba9ff", "jurisdiction": "eu", "migrations_dir": "cloudflare/migrations"}],
  "triggers": {"crons": ["* * * * *"]},
  "vars": {"APP_ORIGIN": "https://salvatucurso.qirris.workers.dev", "AUTH_EMAIL_ENABLED": "false"},
  "observability": {"enabled": false}
}
